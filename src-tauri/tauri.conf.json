{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Baraka Market",
  "version": "1.0.1",
  "identifier": "com.barakamarket.pos",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Baraka Market — Supermarket POS & Management",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' asset: data: blob:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:3100 https://github.com https://objects.githubusercontent.com"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/notoxrious34-prog/BarakaMarket/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdFMEUwNDY2MkM3MDlCNDgKUldSSW0zQXNaZ1FPZnNwelZ4ODBBby9RSnZTSXdFd1h2SDBYLzEyVllPMXlqWFhLdXc2cFFKRVMK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico", "icons/icon.png", "../public/brand/baraka-mark-256.png"],
    "category": "Business",
    "shortDescription": "Système de caisse POS — TVA Algérie, SQLite WAL, Zero-Cloud",
    "longDescription": "Baraka Market v2.0 — offline Algerian POS: fiscal centimes engine, ESC/POS thermal printing, Z-report hash chain, air-gapped licensing. No internet required.",
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "startMenuFolder": "Baraka Market"
      }
    }
  }
}
